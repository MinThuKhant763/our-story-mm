{
  "name": "ourstory-mm-cloudflare",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --config wrangler.jsonc",
    "dev:all": "node scripts/dev-all.mjs",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:production": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "build": "vite build",
    "build:api": "wrangler deploy --dry-run --outdir build-worker --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.mjs",
    "test:workers": "node --test tests/reminders.test.mjs tests/openings.test.mjs",
    "test:integration": "node tests/cloudflare.mjs",
    "deploy:api": "node scripts/check-production.mjs && wrangler deploy --config wrangler.jsonc",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "test:render": "node tests/occasion-render.cjs",
    "test:timer": "node --test tests/fiber-timer.test.mjs",
    "test:operations": "node --test tests/cloudflare-operations.mjs",
    "backup": "node scripts/cloudflare-backup.mjs",
    "backup:unpack": "node scripts/unpack-cloudflare-backup.mjs",
    "build:pages": "wrangler pages functions build functions --outdir build-pages --compatibility-date 2026-10-07"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "fflate": "0.8.3",
    "lucide-react": "1.31.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.1",
    "zod": "3.25.76",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "wrangler": "4.148.0",
    "@cloudflare/workers-types": "5.20261007.1",
    "miniflare": "5.20261006.0-alpha",
    "esbuild": "0.28.1"
  }
}
